{
  "name": "localcircus",
  "version": "0.1.0",
  "description": "LocalCircus - A creative operating environment that amplifies human capability through intelligent tools, automation, and collaboration",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
