  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonamcgoo-dev/localcarnival"
  },
  "keywords": [
    "localcircus",
    "artifacts",
    "workflow",
