{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "strict": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "composite": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "references": [
    { "path": "../core" },
    { "path": "../bigtop" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
