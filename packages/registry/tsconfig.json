{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "composite": true
  },
  "references": [
    { "path": "../core" },
    { "path": "../artifact-sdk" },
    { "path": "../storage" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
